# Supabase Configuration (Authentication & Document Storage)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# AI Writer Configuration (Optional - for AI document generation via OpenRouter)
VITE_OPENROUTER_API_KEY=""
VITE_OPENROUTER_MODELS="google/gemini-2.5-flash,openai/gpt-4o-mini,meta-llama/llama-3.3-70b-instruct"

# Gemini API Key (If using direct Gemini integration)
GEMINI_API_KEY=""
